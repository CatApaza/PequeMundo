{
  "name": "pequemundo",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto académico de frontend: tienda PequeMundo con HTML, CSS, LESS, SASS y Foundation.",
  "scripts": {
    "build": "npm run build:less && npm run build:sass",
    "build:less": "lessc less/estilos.less css/estilos-less.css",
    "build:sass": "sass scss/estilos.scss css/estilos-sass.css --no-source-map",
    "watch:less": "lessc --watch less/estilos.less css/estilos-less.css",
    "watch:sass": "sass --watch scss/estilos.scss css/estilos-sass.css"
  },
  "devDependencies": {
    "less": "^4.2.0",
    "sass": "^1.77.0"
  }
}
